---
import ctaData from '../data/homepage-cta.json';
import { md } from '../lib/markdown';
---

<section class="section-padding">
  <div class="container">
    <div class="prose-width reveal">
      <h2 class="text-h2" style="margin-bottom: 16px;">{ctaData.heading}</h2>
      <p class="text-body-large" style="color: #444444; margin-bottom: 40px;" set:html={md(ctaData.body)}></p>
      <a
        href={ctaData.cta_link}
        class="btn-primary"
        style="margin-bottom: 20px;"
      >
        {ctaData.cta_label}
      </a>
    </div>
  </div>
</section>
