---
import ctaData from '../data/homepage-cta.json';
import { md } from '../lib/markdown';
---

<section class="py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[720px] reveal">
      <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{ctaData.heading}</h2>
      <p class="text-xl leading-[1.5] text-secondary mb-10" set:html={md(ctaData.body)}></p>
      <a
        href={ctaData.cta_link}
        class="btn-primary mb-5"
      >
        {ctaData.cta_label}
      </a>
    </div>
  </div>
</section>
