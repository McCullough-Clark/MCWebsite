---
interface Connection {
  source: string
  detail: string
}

interface Props {
  panel: {
    eyebrow: string
    heading: string
    connections: Connection[]
    destination: string
    result: string
  }
}

const { panel } = Astro.props
---

<figure class="connections-panel" aria-labelledby="connections-panel-title">
  <figcaption>
    <span class="panel-eyebrow">{panel.eyebrow}</span>
    <h2 id="connections-panel-title">{panel.heading}</h2>
  </figcaption>

  <ul class="connection-list" role="list">
    {panel.connections.map((item) => (
      <li class="connection">
        <span class="connection-source">
          <strong>{item.source}</strong>
          <small>{item.detail}</small>
        </span>
        <span class="connection-arrow" aria-hidden="true">→</span>
        <span class="connection-destination">{panel.destination}</span>
      </li>
    ))}
  </ul>

  <p class="panel-result">
    <span aria-hidden="true"></span>
    {panel.result}
  </p>
</figure>

<style>
  .connections-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    color: white;
    background:
      radial-gradient(circle at 90% 5%, rgb(10 110 104 / 0.48), transparent 36%),
      #17324D;
    box-shadow: 0 24px 60px rgb(23 50 77 / 0.2);
  }

  .panel-eyebrow {
    color: #DCE8E1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.5rem;
    color: white;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .connection-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
    list-style: none;
  }

  .connection {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.875rem;
    background: rgb(255 255 255 / 0.08);
  }

  .connection-source strong,
  .connection-source small {
    display: block;
  }

  .connection-source strong {
    font-size: 0.95rem;
  }

  .connection-source small {
    margin-top: 0.1rem;
    color: #DCE8E1;
    font-size: 0.75rem;
  }

  .connection-arrow {
    color: #76D2C7;
    font-weight: 700;
  }

  .connection-destination {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .panel-result {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.25rem;
    color: #DCE8E1;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .panel-result span {
    flex-shrink: 0;
    width: 0.55rem;
    aspect-ratio: 1;
    margin-top: 0.3rem;
    border-radius: 999px;
    background: #76D2C7;
  }
</style>
