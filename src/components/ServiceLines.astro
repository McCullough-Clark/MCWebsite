---
import servicesData from '../data/homepage-services.json';
import { md } from '../lib/markdown';
---

<section id="services" class="section-padding" style="background-color: #FAFAFA; border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <div class="prose-width reveal" style="margin-bottom: 56px;">
      <h2 class="text-h2" style="margin-bottom: 16px;">{servicesData.heading}</h2>
    </div>
    <div class="services-grid reveal-stagger">
      {servicesData.columns.map((col: any) => (
        <div>
          <h3 class="text-h3" style="margin-bottom: 16px;">{col.subheading}</h3>
          <p style="color: #444444; margin-bottom: 20px;" set:html={md(col.body)}></p>
          <a href={col.link_target} style="color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px; font-size: 15px;">
            {col.link_label}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  @media (max-width: 767px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
