---
import servicesData from '../data/homepage-services.json';
import { md } from '../lib/markdown';
---

<section id="services" class="py-16 md:py-24 bg-off-white border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[720px] reveal mb-14">
      <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{servicesData.heading}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 reveal-stagger">
      {servicesData.columns.map((col: any) => (
        <div>
          <h3 class="text-2xl font-medium leading-[1.3] mb-4">{col.subheading}</h3>
          <p class="text-secondary mb-5" set:html={md(col.body)}></p>
          <a href={col.link_target} class="text-body underline underline-offset-[3px] text-[15px]">
            {col.link_label}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
