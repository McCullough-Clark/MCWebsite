---
import heroData from '../data/homepage-hero.json';
import { md } from '../lib/markdown';
---

<section class="section-padding" style="border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <div class="prose-width reveal">
      <p class="text-caption" style="color: #666666; margin-bottom: 24px;">{heroData.eyebrow}</p>
      <h1 class="text-display" style="margin-bottom: 24px;">{heroData.heading}</h1>
      <p class="text-body-large" style="color: #444444; margin-bottom: 40px;" set:html={md(heroData.body)}></p>
      <div>
        <a
          href={heroData.cta_link}
          class="btn-primary"
        >
          {heroData.cta_label}
        </a>
      </div>
    </div>
  </div>
</section>
