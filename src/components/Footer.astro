---
import footerData from '../data/footer.json';
import metadata from '../data/metadata.json';
---

<footer class="border-t border-border pt-16 pb-0">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-[1.2fr_1fr_1fr] gap-10 md:gap-12">
      <div>
        <img
          src="/logos/mc_monogram.svg"
          alt="McCullough Clark"
          class="h-10 w-auto mb-4"
        />
        <p class="text-gray text-sm">
          {footerData.brand_description}
        </p>
        <p class="mt-4">
          <a href="/blog" class="text-gray text-sm underline underline-offset-[3px]">Articles</a>
        </p>
      </div>
      <div>
        <p class="text-[13px] font-medium tracking-[0.1em] uppercase text-body mb-4">{footerData.contact_heading}</p>
        <div class="text-gray text-sm leading-[2]">
          <p>{footerData.contact_name}</p>
          <p><a href={`mailto:${metadata.email}`} class="text-gray no-underline">{metadata.email}</a></p>
          <p><a href={metadata.phone_link} class="text-gray no-underline">{metadata.phone}</a></p>
          <p>{metadata.address}</p>
        </div>
      </div>
      <div>
        <p class="text-[13px] font-medium tracking-[0.1em] uppercase text-body mb-4">{footerData.credentials_heading}</p>
        <div class="text-gray text-sm leading-[2]">
          {footerData.credentials_items.map((item: any) => (
            <p>
              {item.url ? (
                <a href={item.url} class="text-gray underline underline-offset-[3px]" target="_blank" rel="noopener noreferrer">{item.text}</a>
              ) : (
                item.text
              )}
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-border mt-12 py-6">
    <div class="max-w-[1200px] mx-auto px-6 flex justify-between items-center">
      <p class="text-muted text-xs">{footerData.copyright}</p>
    </div>
  </div>
</footer>
