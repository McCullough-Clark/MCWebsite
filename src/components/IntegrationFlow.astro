---
const steps = [
  { system: 'Client intake', action: 'Information submitted', state: 'Received' },
  { system: 'Core system', action: 'Record created or updated', state: 'Synced' },
  { system: 'Team workflow', action: 'Next steps assigned', state: 'Ready' },
  { system: 'Client follow-up', action: 'Confirmation sent', state: 'Delivered' },
]
---

<figure class="integration-flow" aria-labelledby="integration-flow-title">
  <figcaption>
    <span class="flow-eyebrow">Example connected workflow</span>
    <h2 id="integration-flow-title">One intake. Four reliable handoffs.</h2>
  </figcaption>

  <ol class="flow-list">
    {steps.map((step, index) => (
      <li class="flow-step">
        <span class="flow-number">{index + 1}</span>
        <span>
          <small>{step.system}</small>
          <strong>{step.action}</strong>
        </span>
        <span class="flow-state">{step.state}</span>
      </li>
    ))}
  </ol>

  <p class="flow-result">
    <span aria-hidden="true"></span>
    People stay in control. The routine movement happens automatically.
  </p>
</figure>

<style>
  .integration-flow {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.5rem;
    color: white;
    background:
      radial-gradient(circle at 90% 5%, rgb(10 110 104 / 0.48), transparent 36%),
      #17324D;
    box-shadow: 0 24px 60px rgb(23 50 77 / 0.2);
  }

  .flow-eyebrow {
    color: #DCE8E1;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin-top: 0.5rem;
    max-width: 15ch;
    color: white;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .flow-list {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    list-style: none;
  }

  .flow-list::before {
    content: "";
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    width: 2px;
    background: rgb(220 232 225 / 0.35);
  }

  .flow-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.875rem;
    background: rgb(255 255 255 / 0.08);
    backdrop-filter: blur(8px);
  }

  .flow-number {
    z-index: 1;
    display: grid;
    width: 2.5rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 999px;
    background: #0A6E68;
    font-weight: 700;
  }

  .flow-step small,
  .flow-step strong {
    display: block;
  }

  .flow-step small {
    color: #DCE8E1;
    font-size: 0.75rem;
  }

  .flow-step strong {
    margin-top: 0.1rem;
    font-size: 0.925rem;
  }

  .flow-state {
    border-radius: 999px;
    background: rgb(220 232 225 / 0.14);
    padding: 0.35rem 0.55rem;
    color: #DCE8E1;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .flow-result {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    color: #DCE8E1;
    font-size: 0.8rem;
  }

  .flow-result span {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: #76D2C7;
  }

  @media (max-width: 420px) {
    .flow-step {
      grid-template-columns: 2.5rem 1fr;
    }

    .flow-state {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
