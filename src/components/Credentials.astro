---
import credentialsData from '../data/homepage-credentials.json'
---

<section class="border-b border-border bg-white py-8" aria-labelledby="credentials-heading">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 id="credentials-heading" class="sr-only">Professional credentials and platforms</h2>
    <ul class="flex flex-wrap justify-center gap-2 reveal-stagger list-none" role="list">
      {credentialsData.items.map((item: string, index: number) => (
        <li class:list={[
          'inline-flex items-center rounded-full border px-4 py-2 text-[12px] font-semibold tracking-[0.05em]',
          index < 3 ? 'border-terracotta/30 bg-ivory text-navy' : 'border-teal/30 bg-sage text-navy',
        ]}>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
