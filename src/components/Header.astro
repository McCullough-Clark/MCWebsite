---
import metadata from '../data/metadata.json'

const navItems = [
  { label: 'Bookkeeping', href: '/bookkeeping/' },
  { label: 'Integrations', href: '/systems-integration/' },
  { label: 'Automation', href: '/workflow-automation/' },
  { label: 'AI Audit', href: '/audit/' },
  { label: 'Articles', href: '/blog/' },
]

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => {
  const targetPath = href.replace(/\/+$/, '') || '/'
  return currentPath === targetPath
}
---

<header class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur-md">
  <div class="max-w-[1200px] mx-auto px-6 flex items-center justify-between py-4 gap-6">
    <a href="/" aria-label="McCullough Clark home" class="shrink-0">
      <img
        src="/logos/mc_logo_header_light.png"
        srcset="/logos/mc_logo_header_light.png 1x, /logos/mc_logo_header_light_2x.png 2x"
        alt="McCullough Clark"
        width="251"
        height="56"
        class="h-12 max-md:h-10 w-auto block"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="text-sm text-gray no-underline transition-colors duration-150 hover:text-teal">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-5">
      <a href={metadata.phone_link} class="text-sm text-body no-underline whitespace-nowrap">{metadata.phone}</a>
      <a href={metadata.cta_link} class="btn-primary">{metadata.cta_label}</a>
    </div>

    <button
      class="hamburger flex lg:hidden flex-col justify-center gap-[5px] bg-transparent border-none cursor-pointer p-2 min-w-11 min-h-11"
      id="hamburger"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <span class="block w-[22px] h-0.5 bg-navy transition-[transform,opacity] duration-200"></span>
      <span class="block w-[22px] h-0.5 bg-navy transition-[transform,opacity] duration-200"></span>
      <span class="block w-[22px] h-0.5 bg-navy transition-[transform,opacity] duration-200"></span>
    </button>
  </div>

  <div class="mobile-menu lg:hidden border-t border-border bg-white" id="mobile-menu" hidden>
    <nav class="flex flex-col p-6 gap-5" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="text-base text-gray no-underline hover:text-teal">{item.label}</a>
      ))}
      <a href={metadata.phone_link} class="text-base text-body no-underline">{metadata.phone}</a>
      <a href={metadata.cta_link} class="btn-primary text-center">{metadata.cta_label}</a>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('hamburger');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    function setOpen(open) {
      menu.hidden = !open;
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () { setOpen(false); });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });

    var desktop = window.matchMedia('(min-width: 64rem)');
    function closeAtDesktop(event) {
      if (event.matches) setOpen(false);
    }
    if (desktop.addEventListener) desktop.addEventListener('change', closeAtDesktop);
    else desktop.addListener(closeAtDesktop);
  });
</script>

<style>
  .hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }

  .hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
