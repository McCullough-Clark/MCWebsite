---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.whatsIncluded;
---

<section class="section-padding" style="border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <div class="prose-width reveal">
      <h2 class="text-h2" style="margin-bottom: 16px;">{data.heading}</h2>
      <p style="color: #444444; margin-bottom: 48px;" set:html={md(data.intro)}></p>

      <div style="display: flex; flex-direction: column; gap: 44px;">
        {data.items.map((item: any) => (
          <div>
            <h3 class="text-h3" style="margin-bottom: 12px;">{item.title}</h3>
            <p style="color: #444444;" set:html={md(item.description)}></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
