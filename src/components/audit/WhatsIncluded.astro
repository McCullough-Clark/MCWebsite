---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.whatsIncluded;
---

<section class="py-16 md:py-24 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[720px] reveal">
      <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{data.heading}</h2>
      <p class="text-secondary mb-12" set:html={md(data.intro)}></p>

      <div class="flex flex-col gap-11">
        {data.items.map((item: any) => (
          <div>
            <h3 class="text-2xl font-medium leading-[1.3] mb-3">{item.title}</h3>
            <p class="text-secondary" set:html={md(item.description)}></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
