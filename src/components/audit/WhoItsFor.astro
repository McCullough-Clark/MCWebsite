---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.whoItsFor;
---

<section class="section-padding" style="background-color: #FAFAFA; border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <div class="prose-width reveal" style="margin-bottom: 48px;">
      <h2 class="text-h2" style="margin-bottom: 16px;">{data.heading}</h2>
      <p class="text-body-large" style="color: #444444;" set:html={md(data.intro)}></p>
    </div>
    <div class="who-grid reveal-stagger">
      {data.segments.map((seg: any) => (
        <div>
          <p class="text-caption" style="color: #666666; margin-bottom: 16px;">{seg.label}</p>
          <p style="color: #444444;" set:html={md(seg.description)}></p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .who-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  @media (max-width: 767px) {
    .who-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
