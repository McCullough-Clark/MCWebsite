---
import auditData from '../../data/audit.json'
import { md } from '../../lib/markdown'
const hero = auditData.hero
---

<section class="hero-surface py-16 md:py-24 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[820px] reveal">
      <p class="eyebrow text-[13px] tracking-[0.1em] uppercase mb-6">{hero.caption}</p>
      <h1 class="text-[42px] md:text-[64px] font-medium tracking-[-0.025em] leading-[1.04] mb-7">{hero.heading}</h1>
      <p class="text-xl leading-[1.55] text-secondary mb-9" set:html={md(hero.body)}></p>
      <a href={hero.cta_link} class="btn-primary">{hero.cta_label}</a>
    </div>
  </div>
</section>
