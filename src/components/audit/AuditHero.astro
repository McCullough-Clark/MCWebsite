---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const hero = auditData.hero;
---

<section class="section-padding" style="border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <div class="prose-width reveal">
      <p class="text-caption" style="color: #666666; margin-bottom: 24px;">{hero.caption}</p>
      <h1 class="text-display" style="margin-bottom: 24px;">{hero.heading}</h1>
      <p class="text-body-large" style="color: #444444; margin-bottom: 40px;" set:html={md(hero.body)}></p>
      <a
        href={hero.cta_link}
        class="btn-primary"
      >
        {hero.cta_label}
      </a>
    </div>
  </div>
</section>
