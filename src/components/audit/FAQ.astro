---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.faq;
---

<section class="py-16 md:py-24 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[720px] reveal">
      <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-12">{data.heading}</h2>

      <div class="flex flex-col">
        {data.items.map((item: any, i: number) => (
          <details class={`border-t border-border py-6${i === data.items.length - 1 ? ' border-b' : ''}`}>
            <summary class="text-base font-medium pl-7">
              {item.question}
            </summary>
            <p class="text-secondary mt-4 pl-7" set:html={md(item.answer)}></p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
