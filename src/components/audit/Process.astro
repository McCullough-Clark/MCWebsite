---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.process;
---

<section class="py-16 md:py-24 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[720px] reveal mb-12">
      <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{data.heading}</h2>
      <p class="text-xl leading-[1.5] text-secondary">{data.subheading}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 reveal-stagger">
      {data.weeks.map((week: any) => (
        <div>
          <p class="text-[13px] tracking-[0.1em] uppercase text-gray mb-4">{week.label}</p>
          <h3 class="text-2xl font-medium leading-[1.3] mb-3">{week.title}</h3>
          <p class="text-secondary" set:html={md(week.description)}></p>
        </div>
      ))}
    </div>
  </div>
</section>
