---
import auditData from '../../data/audit.json';
import { md } from '../../lib/markdown';
const data = auditData.pricing;
---

<section class="section-padding" style="background-color: #FAFAFA; border-bottom: 1px solid #E5E5E5;">
  <div class="container">
    <h2 class="text-h2 reveal" style="margin-bottom: 48px;">{data.heading}</h2>
    <div class="pricing-grid reveal-stagger">
      <div>
        <p class="text-caption" style="color: #666666; margin-bottom: 16px;">{data.fixed_fee.label}</p>
        <h3 style="font-size: 48px; font-weight: 500; letter-spacing: -0.02em; margin-bottom: 20px;">{data.fixed_fee.amount}</h3>
        <p style="color: #444444;" set:html={md(data.fixed_fee.description)}></p>
      </div>
      <div>
        <p class="text-caption" style="color: #666666; margin-bottom: 16px;">{data.not_included.label}</p>
        <p style="color: #444444; margin-top: 36px;" set:html={md(data.not_included.description)}></p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }

  @media (max-width: 767px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
