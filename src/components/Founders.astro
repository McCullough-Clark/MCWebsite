---
import aboutData from '../data/homepage-about.json'
import { md } from '../lib/markdown'
---

<section id="about" class="py-16 md:py-24 bg-ivory border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="max-w-[760px] reveal mb-12">
      <p class="eyebrow text-[13px] tracking-[0.1em] uppercase mb-4">{aboutData.eyebrow}</p>
      <h2 class="text-[32px] md:text-[44px] font-medium tracking-[-0.015em] leading-[1.12] mb-5">{aboutData.heading}</h2>
      <p class="text-xl leading-[1.5] text-secondary" set:html={md(aboutData.lede)}></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal-stagger">
      <article class="bg-white border border-border border-t-[5px] border-t-navy rounded-[8px] p-7 md:p-9">
        {aboutData.founder1.photo && (
          <img src={aboutData.founder1.photo} alt={aboutData.founder1.name} class="w-full aspect-[4/5] object-cover mb-6 rounded-[5px]" />
        )}
        <p class="text-[12px] tracking-[0.12em] uppercase font-semibold text-navy mb-3">{aboutData.founder1.title}</p>
        <h3 class="text-2xl font-medium leading-[1.3] mb-4">{aboutData.founder1.name}</h3>
        <p class="text-secondary" set:html={md(aboutData.founder1.bio)}></p>
      </article>

      <article class="bg-white border border-border border-t-[5px] border-t-navy rounded-[8px] p-7 md:p-9">
        {aboutData.founder2.photo && (
          <img src={aboutData.founder2.photo} alt={aboutData.founder2.name} class="w-full aspect-[4/5] object-cover mb-6 rounded-[5px]" />
        )}
        <p class="text-[12px] tracking-[0.12em] uppercase font-semibold text-navy mb-3">{aboutData.founder2.title}</p>
        <h3 class="text-2xl font-medium leading-[1.3] mb-4">{aboutData.founder2.name}</h3>
        <p class="text-secondary" set:html={md(aboutData.founder2.bio)}></p>
      </article>
    </div>
  </div>
</section>
