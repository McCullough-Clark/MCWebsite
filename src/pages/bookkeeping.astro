---
import BaseLayout from '../layouts/BaseLayout.astro'
import bookkeepingData from '../data/bookkeeping.json'
import { md } from '../lib/markdown'
const hero = bookkeepingData.hero;
const who = bookkeepingData.who;
const included = bookkeepingData.included;
const faster = bookkeepingData.faster;
const remote = bookkeepingData.remote;
const cta = bookkeepingData.cta;
---

<BaseLayout
  title="Bookkeeping with Sharla Clark, EA | McCullough Clark"
  description="Monthly bookkeeping owned by Sharla Clark, EA. QuickBooks Online setup, cleanup, and ongoing books for small businesses in multiple states."
  ogTitle="Bookkeeping with Sharla Clark, EA | McCullough Clark"
  ogDescription="Monthly bookkeeping owned by an Enrolled Agent with 25+ years in accounting. QuickBooks Online setup, cleanup, and ongoing books."
  ogUrl="https://mcculloughclark.com/bookkeeping"
>
  <!-- Hero -->
  <section class="py-16 md:py-24 border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <p class="text-[13px] tracking-[0.1em] uppercase text-gray mb-6">{hero.caption}</p>
        <h1 class="text-[40px] md:text-[64px] font-medium tracking-[-0.02em] leading-[1.1] mb-6">{hero.heading}</h1>
        <p class="text-xl leading-[1.5] text-secondary mb-10" set:html={md(hero.body)}></p>
        <a
          href={hero.cta_link}
          class="btn-primary"
        >
          {hero.cta_label}
        </a>
      </div>
    </div>
  </section>

  <!-- Who you're working with -->
  <section class="py-16 md:py-24 bg-off-white border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-10">{who.heading}</h2>
        <h3 class="text-2xl font-medium leading-[1.3] mb-2">{who.name}</h3>
        <p class="text-[13px] tracking-[0.1em] uppercase text-gray mb-5">{who.title}</p>
        {who.paragraphs.map((paragraph: string) => (
          <p class="text-secondary mb-5" set:html={md(paragraph)}></p>
        ))}
        <a href={who.link_target} class="text-gray underline underline-offset-[3px] text-sm">
          {who.link_label}
        </a>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-16 md:py-24 border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{included.heading}</h2>
        <p class="text-secondary mb-12" set:html={md(included.intro)}></p>

        <div class="flex flex-col gap-11">
          {included.items.map((item: any) => (
            <div>
              <h3 class="text-2xl font-medium leading-[1.3] mb-3">{item.title}</h3>
              <p class="text-secondary" set:html={md(item.description)}></p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why books close faster here -->
  <section class="py-16 md:py-24 bg-off-white border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{faster.heading}</h2>
        {faster.paragraphs.map((paragraph: string) => (
          <p class="text-secondary mb-5" set:html={md(paragraph)}></p>
        ))}
      </div>
    </div>
  </section>

  <!-- Remote works -->
  <section class="py-16 md:py-24 border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal mb-12">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{remote.heading}</h2>
        <p class="text-xl leading-[1.5] text-secondary" set:html={md(remote.intro)}></p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 reveal-stagger">
        {remote.segments.map((seg: any) => (
          <div>
            <p class="text-[13px] tracking-[0.1em] uppercase text-gray mb-4">{seg.label}</p>
            <p class="text-secondary" set:html={md(seg.description)}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{cta.heading}</h2>
        <p class="text-xl leading-[1.5] text-secondary mb-10" set:html={md(cta.body)}></p>
        <a
          href={cta.cta_link}
          class="btn-primary"
        >
          {cta.cta_label}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
