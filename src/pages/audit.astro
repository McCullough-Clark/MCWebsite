---
import BaseLayout from '../layouts/BaseLayout.astro'
import AuditHero from '../components/audit/AuditHero.astro'
import WhoItsFor from '../components/audit/WhoItsFor.astro'
import WhatsIncluded from '../components/audit/WhatsIncluded.astro'
import Process from '../components/audit/Process.astro'
import Pricing from '../components/audit/Pricing.astro'
import FAQ from '../components/audit/FAQ.astro'
import auditData from '../data/audit.json'
import { md } from '../lib/markdown'
const samples = auditData.samples;
const cta = auditData.cta;
---

<BaseLayout
  title="AI Operations Audit — McCullough Clark"
  description="A structured three-week audit of where AI saves real time in your service business. Fixed fee. Includes risk and access review."
  ogTitle="AI Operations Audit — McCullough Clark"
  ogDescription="Three-week assessment. Written deliverable. Fixed fee. Includes risk and access review."
  ogUrl="https://mcculloughclark.com/audit"
  robots="noindex, nofollow"
>
  <AuditHero />
  <WhoItsFor />
  <WhatsIncluded />

  <!-- Section 4: Sample deliverables -->
  <section class="py-16 md:py-24 bg-off-white border-b border-border">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal mb-12">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{samples.heading}</h2>
        <p class="text-secondary" set:html={md(samples.intro)}></p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 reveal-stagger">
        {samples.items.map((item: any) => (
          <div>
            <p class="text-[13px] tracking-[0.1em] uppercase text-gray mb-4">{item.label}</p>
            <h3 class="text-2xl font-medium leading-[1.3] mb-3">{item.title}</h3>
            <p class="text-secondary mb-5" set:html={md(item.description)}></p>
            <a href={item.link_target} class="text-gray underline underline-offset-[3px] text-sm">
              {item.link_label}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Process />
  <Pricing />
  <FAQ />

  <!-- Final CTA -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="max-w-[720px] reveal">
        <h2 class="text-[28px] md:text-[40px] font-medium tracking-[-0.01em] leading-[1.2] mb-4">{cta.heading}</h2>
        <p class="text-xl leading-[1.5] text-secondary mb-10" set:html={md(cta.body)}></p>
        <a
          href={cta.cta_link}
          class="btn-primary"
        >
          {cta.cta_label}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
