---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import metadata from '../../data/metadata.json';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const published = allPosts.filter((post) => post.data.status === 'Published');
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const ogImage = post.data.featured_image || '/og-image.png';
---

<BaseLayout
  title={`${post.data.title} — McCullough Clark`}
  description={post.data.summary}
  ogTitle={post.data.title}
  ogDescription={post.data.summary}
  ogUrl={`https://mcculloughclark.com/blog/${post.id}`}
>
  <section class="section-padding" style="border-bottom: 1px solid #E5E5E5;">
    <div class="container">
      <div class="prose-width reveal">
        <p class="text-caption" style="color: #666666; margin-bottom: 16px;">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.author && ` · ${post.data.author}`}
        </p>
        <h1 class="text-display" style="margin-bottom: 32px;">{post.data.title}</h1>

        {post.data.featured_image && (
          <img
            src={post.data.featured_image}
            alt={post.data.featured_image_alt || ''}
            style="width: 100%; margin-bottom: 40px;"
          />
        )}

        <div class="blog-content">
          <Content />
        </div>

        <div style="border-top: 1px solid #E5E5E5; margin-top: 56px; padding-top: 32px;">
          <p style="color: #444444; margin-bottom: 16px;">
            Written by Sharla Clark, EA, MBA — founder of McCullough Clark.
          </p>
          <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
            <a
              href={`mailto:${metadata.email}?subject=${metadata.email_subject}`}
              class="btn-primary"
            >
              Schedule a conversation
            </a>
            <a
              href="https://proadvisor.intuit.com/app/accountant/search?searchId=sharla-clark"
              style="color: #666666; text-decoration: underline; text-underline-offset: 3px; font-size: 14px;"
              target="_blank"
              rel="noopener noreferrer"
            >
              QuickBooks ProAdvisor profile
            </a>
          </div>
        </div>

        <p style="margin-top: 40px;">
          <a href="/blog" style="color: #666666; text-decoration: underline; text-underline-offset: 3px; font-size: 14px;">
            ← Back to articles
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
